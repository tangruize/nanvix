verus!{
fn verus_verified_exec_tracked(
    x: u32,
    Tracked(y): Tracked&lt;&amp;mut u32&gt;,
    Ghost(w): Ghost&lt;u32&gt;,
) -&gt; (ret: (u32, Ghost&lt;u32&gt;))
requires
  x &lt; 100,
  *old(y) &lt; 100,
ensures
  *y == x,
  ret.0 == x + 1,
  ret.1@ == x,
 {
  proof! {
    *y = x;
  }
  ((x + 1), Ghost(x))
}

fn exec_tracked(x: u32) -&gt; u32
requires
  false
{
  unimplemented!()
}

fn exec_tracked_test(x: u32) {
  let ghost mut z = 0u32;
  let tracked mut y = 0u32;

  let tmp = verus_verified_exec_tracked(1, Tracked(&amp;mut y), Ghost(0));
  let x = tmp.0
  proof {z = tmp@;}
  proof{
    assert(y == 1);
    assert(z == 1);
    assert(x == 2);
  }
}

}

fn exec_external_test(x: u32) -&gt; u32 {
   exec_tracked(1)
}
