<h2 dir="auto">Tracked and Ghost variables used as function inputs and outputs</h2>
<markdown-accessiblity-table><table role="table">
<tbody><tr>
<td>
<div class="highlight highlight-source-rust notranslate position-relative overflow-auto" dir="auto" data-snippet-clipboard-copy-content="#[verus_spec(ret =&gt;
with
  Tracked(y): Tracked&lt;&amp;mut u32&gt;,
  Ghost(w): Ghost&lt;u32&gt; 
     -&gt; z: Ghost&lt;u32&gt;
requires
  x &lt; 100,
  *old(y) &lt; 100,
ensures
  *y == x,
  ret == x + 1,
  z@ == x,
)]
fn exec_tracked(x: u32) -&gt; u32 {
  proof! {
    *y = x;
  }
  proof_with!(|= Ghost(x));
  (x + 1)
}







#[verus_spec]
fn exec_tracked_test(x: u32) {
  proof_decl!{
   let ghost mut z = 0u32;
   let tracked mut y = 0u32;
  }

  proof_with!{Tracked(&amp;mut y), Ghost(0)=&gt; Ghost(z)}
  let x = exec_tracked(1);

  proof!{
    assert(y == 1);
    assert(z == 1);
    assert(x == 2);
  }
}

fn exec_external_test(x: u32) -&gt; u32 {
   exec_tracked(1)
}
"><pre class="notranslate"><span class="pl-c1">#<span class="pl-kos">[</span>verus_spec<span class="pl-kos">(</span>ret =&gt;</span>
<span class="pl-c1">with</span>
